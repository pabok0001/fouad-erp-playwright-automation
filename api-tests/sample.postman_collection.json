{
  "info": {
    "name": "Sample API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" }
  ],
  "item": [
    {
      "name": "Get post",
      "request": { "method": "GET", "url": "{{baseUrl}}/posts/1" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('has id 1', () => pm.expect(pm.response.json().id).to.eql(1));",
              "pm.test('responds under 2s', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create post",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/posts",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"title\":\"foo\",\"body\":\"bar\",\"userId\":1}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.test('title echoed', () => pm.expect(pm.response.json().title).to.eql('foo'));"
            ]
          }
        }
      ]
    }
  ]
}
